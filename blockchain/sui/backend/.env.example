# Backend — copy thành backend/.env rồi điền giá trị thật.
# Private key KHÔNG nằm ở đây: backend ký TX qua keystore của SUI CLI.

APP_NAME=vn-history-gamefi-backend

# Mạng SUI: testnet | local
SUI_NETWORK=testnet
# Public fullnode của Mysten đã bỏ JSON-RPC/GraphQL -> dùng RPC cộng đồng.
SUI_RPC_URL=https://testnet.suiet.app
# Để trống: bỏ qua GraphQL, adapter đọc thẳng JSON-RPC.
SUI_GRAPHQL_URL=

# Lấy từ deployments/sui-<env>.json sau khi chạy scripts/deploy-sui.sh
SUI_PACKAGE_ID=
SUI_CATALOG_ID=
SUI_TREASURY_ID=
SUI_FACTION_ADMIN_ID=
SUI_REWARD_ADMIN_ID=

# Đường dẫn SUI CLI. Backend gọi subprocess từ CWD backend/ nên dùng đường dẫn tuyệt đối.
# Windows bị Smart App Control chặn sui.exe -> trỏ tới wrapper Docker của repo.
SUI_CLI_PATH=C:/path/to/repo/scripts/sui-docker.cmd
SUI_CLI_CONFIG=
SUI_GAS_BUDGET=50000000

# Reward mặc định mỗi battle (MIST)
REWARD_AMOUNT_MIST=5000000
NONCE_TTL_SECONDS=300
FACTIONS_FILE=assets/nft/factions.json
