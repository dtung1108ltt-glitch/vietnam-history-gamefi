# Frontend — copy thành frontend/.env rồi điền giá trị thật.

VITE_API_URL=http://localhost:8000

# testnet | localnet
VITE_SUI_NETWORK=testnet
# Bỏ trống thì dùng mặc định theo network (testnet: https://testnet.suiet.app,
# localnet: http://127.0.0.1:9000). Public fullnode của Mysten đã bỏ JSON-RPC.
VITE_SUI_RPC_URL=

# Lấy từ deployments/sui-<env>.json (thiếu 2 giá trị này thì nút Mint bị khoá)
VITE_SUI_PACKAGE_ID=
VITE_SUI_CATALOG_ID=
